{
 "about": "Visual node-graph catalog for Stark World Engine Systems. A graph (systems.graphs[]) compiles to StarkScript (the sandboxed JavaScript subset) with these templates: {param} = the parameter's expression (a data link or the literal value), {>out} = the code of the exec chain leaving that output, {id} = a unique suffix. Kinds: event (starts a chain), action (does something, continues on 'next'), flow (branches), data (an expression, no exec). The UE5 / Godot bridges map the same type names to Blueprint / GDScript nodes.",
 "version": 1,
 "nodes": {
  "event.start":        {"kind": "event", "out": ["exec"], "code": "on('start', function (ev) {\n{>exec}\n});", "desc": "When the game starts"},
  "event.update":       {"kind": "event", "out": ["exec"], "code": "on('update', function (ev) {\n{>exec}\n});", "desc": "Every frame (ev.dt seconds)"},
  "event.interact":     {"kind": "event", "out": ["exec"], "code": "on('interact', function (ev) {\n{>exec}\n});", "desc": "When the player uses this entity (or any, if the graph has no entity)"},
  "event.questStep":    {"kind": "event", "out": ["exec"], "params": {"quest": "string"}, "code": "on('questStep', function (ev) { if ({quest} && ev.quest !== {quest}) return;\n{>exec}\n});", "desc": "When a quest reaches a new step"},
  "event.questDone":    {"kind": "event", "out": ["exec"], "params": {"quest": "string"}, "code": "on('questDone', function (ev) { if ({quest} && ev.quest !== {quest}) return;\n{>exec}\n});", "desc": "When a quest is completed"},
  "event.enterZone":    {"kind": "event", "out": ["exec"], "params": {"zone": "string"}, "code": "on('enterZone', function (ev) { if ({zone} && ev.zone !== {zone}) return;\n{>exec}\n});", "desc": "When the player enters a trigger zone"},
  "event.damage":       {"kind": "event", "out": ["exec"], "code": "on('damage', function (ev) {\n{>exec}\n});", "desc": "When something takes damage"},
  "event.death":        {"kind": "event", "out": ["exec"], "code": "on('death', function (ev) {\n{>exec}\n});", "desc": "When something is defeated"},
  "event.collect":      {"kind": "event", "out": ["exec"], "params": {"item": "string"}, "code": "on('collect', function (ev) { if ({item} && ev.item !== {item}) return;\n{>exec}\n});", "desc": "When the player picks up an item"},
  "event.hour":         {"kind": "event", "out": ["exec"], "params": {"hour": "number"}, "code": "on('hour', function (ev) { if ({hour} >= 0 && ev.hour !== {hour}) return;\n{>exec}\n});", "desc": "When the in-game clock reaches an hour (-1 = every hour)"},
  "event.timer":        {"kind": "event", "out": ["exec"], "params": {"seconds": "number"}, "code": "every({seconds}, function () { var ev = {};\n{>exec}\n});", "desc": "Every N seconds"},
  "event.choice":       {"kind": "event", "out": ["exec"], "params": {"dialog": "string"}, "code": "on('dialogueChoice', function (ev) { if ({dialog} && ev.dialog !== {dialog}) return;\n{>exec}\n});", "desc": "When the player picks a dialogue answer"},
  "flow.if":            {"kind": "flow", "in": ["exec"], "out": ["true", "false", "next"], "params": {"cond": "bool"}, "code": "if ({cond}) {\n{>true}\n} else {\n{>false}\n}\n{>next}", "desc": "Branch on a condition"},
  "flow.sequence":      {"kind": "flow", "in": ["exec"], "out": ["a", "b", "c"], "code": "{>a}\n{>b}\n{>c}", "desc": "Run outputs in order"},
  "flow.loop":          {"kind": "flow", "in": ["exec"], "out": ["body", "next"], "params": {"count": "number"}, "code": "for (var i{id} = 0; i{id} < Math.min(1000, {count}); i{id}++) {\n{>body}\n}\n{>next}", "desc": "Repeat N times (at most 1000)"},
  "flow.wait":          {"kind": "flow", "in": ["exec"], "out": ["next"], "params": {"seconds": "number"}, "code": "after({seconds}, function () {\n{>next}\n});", "desc": "Wait, then continue"},
  "flow.once":          {"kind": "flow", "in": ["exec"], "out": ["next"], "code": "if (!vars.get('__once{id}')) { vars.set('__once{id}', true);\n{>next}\n}", "desc": "Only the first time"},
  "flow.chance":        {"kind": "flow", "in": ["exec"], "out": ["yes", "no"], "params": {"p": "number"}, "code": "if (rand() < {p}) {\n{>yes}\n} else {\n{>no}\n}", "desc": "Random branch"},
  "ui.say":             {"kind": "action", "in": ["exec"], "out": ["next"], "params": {"speaker": "string", "text": "string"}, "code": "ui.say({speaker}, {text});\n{>next}", "desc": "Show a line"},
  "ui.toast":           {"kind": "action", "in": ["exec"], "out": ["next"], "params": {"text": "string"}, "code": "ui.toast({text});\n{>next}", "desc": "Small message"},
  "ui.set":             {"kind": "action", "in": ["exec"], "out": ["next"], "params": {"name": "string", "value": "any"}, "code": "ui.set({name}, {value});\n{>next}", "desc": "Set a HUD value"},
  "inventory.give":     {"kind": "action", "in": ["exec"], "out": ["next"], "params": {"item": "string", "n": "number"}, "code": "inventory.give({item}, {n});\n{>next}", "desc": "Give the player items"},
  "inventory.take":     {"kind": "action", "in": ["exec"], "out": ["next"], "params": {"item": "string", "n": "number"}, "code": "inventory.take({item}, {n});\n{>next}", "desc": "Take items from the player"},
  "quests.start":       {"kind": "action", "in": ["exec"], "out": ["next"], "params": {"quest": "string"}, "code": "quests.start({quest});\n{>next}", "desc": "Start a quest"},
  "quests.complete":    {"kind": "action", "in": ["exec"], "out": ["next"], "params": {"quest": "string"}, "code": "quests.complete({quest});\n{>next}", "desc": "Complete a quest"},
  "quests.event":       {"kind": "action", "in": ["exec"], "out": ["next"], "params": {"event": "string"}, "code": "emit('questEvent', {event: {event}});\n{>next}", "desc": "Advance 'custom' quest steps"},
  "entity.moveTo":      {"kind": "action", "in": ["exec"], "out": ["next"], "params": {"entity": "entity", "x": "number", "z": "number"}, "code": "ai.goTo({entity}, {x}, {z});\n{>next}", "desc": "Walk somewhere"},
  "entity.teleport":    {"kind": "action", "in": ["exec"], "out": ["next"], "params": {"entity": "entity", "x": "number", "z": "number"}, "code": "(function (e) { if (e) { e.x = {x}; e.z = {z}; } })(world.find({entity}));\n{>next}", "desc": "Move instantly"},
  "entity.spawn":       {"kind": "action", "in": ["exec"], "out": ["next"], "params": {"kind": "string", "name": "string", "x": "number", "z": "number"}, "code": "world.spawn({kind: {kind}, name: {name}, x: {x}, z: {z}});\n{>next}", "desc": "Create an entity"},
  "entity.setHostile":  {"kind": "action", "in": ["exec"], "out": ["next"], "params": {"entity": "entity", "value": "bool"}, "code": "(function (e) { if (e) e.setHostile({value}); })(world.find({entity}));\n{>next}", "desc": "Make an entity hostile or friendly (never a child)"},
  "combat.damage":      {"kind": "action", "in": ["exec"], "out": ["next"], "params": {"target": "entity", "amount": "number"}, "code": "combat.damage({target}, {amount});\n{>next}", "desc": "Damage a target (never a child)"},
  "combat.heal":        {"kind": "action", "in": ["exec"], "out": ["next"], "params": {"target": "entity", "amount": "number"}, "code": "combat.heal({target}, {amount});\n{>next}", "desc": "Heal a target"},
  "ai.setBehavior":     {"kind": "action", "in": ["exec"], "out": ["next"], "params": {"entity": "entity", "behavior": "string"}, "code": "ai.setBehavior({entity}, {behavior});\n{>next}", "desc": "Change AI behaviour"},
  "factions.addRep":    {"kind": "action", "in": ["exec"], "out": ["next"], "params": {"faction": "string", "amount": "number"}, "code": "factions.addRep({faction}, {amount});\n{>next}", "desc": "Change reputation"},
  "economy.addGold":    {"kind": "action", "in": ["exec"], "out": ["next"], "params": {"amount": "number"}, "code": "economy.add({amount});\n{>next}", "desc": "Give or take gold"},
  "progression.award":  {"kind": "action", "in": ["exec"], "out": ["next"], "params": {"xp": "number"}, "code": "progression.award({xp});\n{>next}", "desc": "Give XP"},
  "audio.play":         {"kind": "action", "in": ["exec"], "out": ["next"], "params": {"cue": "string"}, "code": "audio.play({cue});\n{>next}", "desc": "Play a sound cue"},
  "audio.music":        {"kind": "action", "in": ["exec"], "out": ["next"], "params": {"state": "string"}, "code": "audio.music({state});\n{>next}", "desc": "Switch music state"},
  "camera.shake":       {"kind": "action", "in": ["exec"], "out": ["next"], "params": {"amount": "number"}, "code": "camera.shake({amount});\n{>next}", "desc": "Shake the camera"},
  "camera.cinematic":   {"kind": "action", "in": ["exec"], "out": ["next"], "params": {"id": "string"}, "code": "camera.play({id});\n{>next}", "desc": "Play a cinematic"},
  "world.setWeather":   {"kind": "action", "in": ["exec"], "out": ["next"], "params": {"type": "string"}, "code": "world.setWeather({type});\n{>next}", "desc": "Change the weather"},
  "vars.set":           {"kind": "action", "in": ["exec"], "out": ["next"], "params": {"name": "string", "value": "any"}, "code": "vars.set({name}, {value});\n{>next}", "desc": "Set a saved variable"},
  "vars.add":           {"kind": "action", "in": ["exec"], "out": ["next"], "params": {"name": "string", "amount": "number"}, "code": "vars.set({name}, (+vars.get({name}) || 0) + {amount});\n{>next}", "desc": "Add to a saved variable"},
  "dialogue.start":     {"kind": "action", "in": ["exec"], "out": ["next"], "params": {"dialog": "string", "npc": "entity"}, "code": "dialogue.start({dialog}, {npc});\n{>next}", "desc": "Open a conversation"},
  "value.number":       {"kind": "data", "params": {"value": "number"}, "code": "{value}"},
  "value.string":       {"kind": "data", "params": {"value": "string"}, "code": "{value}"},
  "value.bool":         {"kind": "data", "params": {"value": "bool"}, "code": "{value}"},
  "vars.get":           {"kind": "data", "params": {"name": "string"}, "code": "vars.get({name})"},
  "event.field":        {"kind": "data", "params": {"field": "string"}, "code": "(ev ? ev[{field}] : undefined)"},
  "math.add":           {"kind": "data", "params": {"a": "number", "b": "number"}, "code": "({a} + {b})"},
  "math.sub":           {"kind": "data", "params": {"a": "number", "b": "number"}, "code": "({a} - {b})"},
  "math.mul":           {"kind": "data", "params": {"a": "number", "b": "number"}, "code": "({a} * {b})"},
  "math.random":        {"kind": "data", "params": {"min": "number", "max": "number"}, "code": "randInt({min}, {max})"},
  "compare.eq":         {"kind": "data", "params": {"a": "any", "b": "any"}, "code": "({a} === {b})"},
  "compare.gte":        {"kind": "data", "params": {"a": "number", "b": "number"}, "code": "({a} >= {b})"},
  "compare.lt":         {"kind": "data", "params": {"a": "number", "b": "number"}, "code": "({a} < {b})"},
  "logic.and":          {"kind": "data", "params": {"a": "bool", "b": "bool"}, "code": "({a} && {b})"},
  "logic.or":           {"kind": "data", "params": {"a": "bool", "b": "bool"}, "code": "({a} || {b})"},
  "logic.not":          {"kind": "data", "params": {"a": "bool"}, "code": "(!{a})"},
  "inventory.has":      {"kind": "data", "params": {"item": "string", "n": "number"}, "code": "inventory.has({item}, {n})"},
  "inventory.count":    {"kind": "data", "params": {"item": "string"}, "code": "inventory.count({item})"},
  "quests.state":       {"kind": "data", "params": {"quest": "string"}, "code": "quests.state({quest})"},
  "factions.rep":       {"kind": "data", "params": {"faction": "string"}, "code": "factions.rep({faction})"},
  "world.hour":         {"kind": "data", "code": "world.hour"},
  "world.isNight":      {"kind": "data", "code": "world.isNight"},
  "economy.gold":       {"kind": "data", "code": "economy.gold()"},
  "player.hp":          {"kind": "data", "code": "world.player.hp"},
  "entity.self":        {"kind": "data", "code": "self"}
 }
}
